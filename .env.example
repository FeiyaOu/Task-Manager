# Copy this file to `.env` in the project root and adjust the values.
# The backend reads it on startup (see backend/app/config.py).

# Absolute path to the LOCAL git repository the app should analyze.
# This is the team's project being managed — NOT this app.
REPO_PATH=/absolute/path/to/your/repo

# SQLite database location (relative paths are resolved from where you run the app).
DATABASE_URL=sqlite:///./taskmanager.db

# Recency decay constant for expertise scoring (larger = older commits fade faster).
DECAY_LAMBDA=0.01

# How many leading path directories form a module (1 = top-level folder, 2 = sub-folder).
MODULE_DEPTH=1

# Reserved for the accept/decline reassignment extension.
MAX_REASSIGNMENTS=3

# Minimum top score required to assign a bug; below this the task is UNASSIGNED.
ASSIGN_THRESHOLD=0.0

# Tiered-fallback gates: if the module-scoped match is below ASSIGN_THRESHOLD,
# assignment broadens to the parent module (BROADEN_THRESHOLD) then to a text-only
# match (TEXT_THRESHOLD) before giving up. 0.0 = assign whenever any signal exists.
BROADEN_THRESHOLD=0.0
TEXT_THRESHOLD=0.0

# Allowed frontend origin(s) for CORS, as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]
